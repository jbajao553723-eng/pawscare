{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build PawCare Desktop",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/PawCare.Desktop/PawCare.Desktop.csproj",
        "--configuration",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test PawCare data flows",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/tests/PawCare.SmokeTests/PawCare.SmokeTests.csproj",
        "--configuration",
        "Release"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
