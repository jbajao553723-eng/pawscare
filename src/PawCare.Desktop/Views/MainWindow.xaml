<Window x:Class="PawCare.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PawCare Veterinary CRM"
        Width="1440" Height="900" MinWidth="1120" MinHeight="700"
        Icon="/PawCare.Desktop;component/Assets/PawCareIcon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ContentSurfaceBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource ForestBrush}">
            <Grid Margin="18,20,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="2,0,2,18">
                    <Border Height="92" Background="White" CornerRadius="14" Padding="8">
                        <Image Source="/PawCare.Desktop;component/Assets/PawCareBrand.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="CLINIC MANAGEMENT" Foreground="#90A097" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavigationStack" />
                </ScrollViewer>

                <Border Grid.Row="2" Background="#10FFFFFF" BorderBrush="#17FFFFFF" BorderThickness="1" CornerRadius="13" Padding="13" Margin="0,12,0,12">
                    <StackPanel>
                        <TextBlock Text="Navigation tip" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Text="Use the search bar for any client or pet. In a module, select a row or double-click it to open the record." Foreground="#B8C4BD" FontSize="9" TextWrapping="Wrap" LineHeight="14" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" BorderBrush="#18FFFFFF" BorderThickness="0,1,0,0" Padding="3,13,3,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" Background="{StaticResource GoldSoftBrush}" CornerRadius="9">
                            <TextBlock x:Name="SidebarInitials" Foreground="{StaticResource ForestDarkBrush}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="9,0,5,0" VerticalAlignment="Center">
                            <TextBlock x:Name="SidebarName" Foreground="White" FontWeight="SemiBold" FontSize="10" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SidebarRole" Foreground="#96A69D" FontSize="8" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Foreground="#C3CEC7" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Sign out" Click="SignOutButton_Click" FocusVisualStyle="{StaticResource PawFocusVisual}">
                            <Viewbox Width="17" Height="17"><Path Data="M9,4 L4,4 L4,20 L9,20 M13,8 L17,12 L13,16 M7,12 L17,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="82" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#F5FAFAF8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="30,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="BreadcrumbText" Text="PAWCARE / OVERVIEW" Foreground="#78867E" FontSize="9" FontWeight="SemiBold" />
                        <TextBlock x:Name="PageTitleText" Foreground="{StaticResource ForestDarkBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="288" Height="40" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,12,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="39" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M10.5,18 A7.5,7.5 0 1 1 10.5,3 A7.5,7.5 0 0 1 10.5,18 M16,16 L21,21" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Viewbox>
                                <Grid Grid.Column="1">
                                    <TextBlock x:Name="GlobalSearchHint" Text="Search clients, pets, inquiries…" Foreground="#849088" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False" />
                                    <TextBox x:Name="GlobalSearchTextBox" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="11" Padding="0,0,8,0" ToolTip="Press Enter to search" KeyDown="GlobalSearchTextBox_KeyDown" TextChanged="GlobalSearchTextBox_TextChanged" />
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Width="40" Height="40" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,12,0" ToolTip="Notifications">
                            <Viewbox Width="17" Height="17"><Path Data="M6,17 L18,17 M8,17 L8,10 C8,5 16,5 16,10 L16,17 M10,20 C11,21 13,21 14,20" Stroke="{StaticResource ForestBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox>
                        </Border>
                        <Border Width="40" Height="40" Background="{StaticResource GoldSoftBrush}" CornerRadius="10">
                            <TextBlock x:Name="HeaderInitials" Foreground="{StaticResource ForestDarkBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="ContentHost" Margin="30,26,30,42" />
            </ScrollViewer>
        </Grid>

        <Border x:Name="ModalScrim"
                Grid.ColumnSpan="2"
                Panel.ZIndex="100"
                Background="#660F1B15"
                Visibility="Collapsed"
                IsHitTestVisible="False" />
    </Grid>
</Window>
